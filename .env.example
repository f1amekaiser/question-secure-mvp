# Application signing and encryption secret.
# Generate a long random value for production.
APP_SECRET=replace-with-a-long-random-secret

# Production: paste the pooled Neon PostgreSQL connection string here.
# Neon URLs should include sslmode=require; the app adds it if missing.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional alias supported by the app when DATABASE_URL is not set.
# NEON_DATABASE_URL=

# Demo-sized recursive time-puzzle settings.
PUZZLE_ROUNDS_PER_DAY=1000
MAX_PUZZLE_ROUNDS=2000000
